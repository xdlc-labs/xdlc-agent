# Build / release
/bin/
/dist/
/xdlc-agent
*.exe
*.test
coverage.out
coverage.html

# Local agent runtime (generated by xdlc-agent)
/repos/
*.db
BACKLOG.md
LESSONS.md
config.yaml
.env

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~
.claude/

# UI (ui/.gitignore also covers these; listed for root clarity)
ui/node_modules/
ui/dist/
ui/.output/
ui/.tanstack/
ui/.nitro/
ui/.wrangler/

# Built binaries checked in by mistake
services/example-service/example-service

# Terraform / IaC (infra/, cloud bootstrap) — state and vars carry
# resource IDs and secrets, must live in a remote backend, never in git
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Credentials / keys — should never be committed regardless of directory
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
kubeconfig*
.kube/
.aws/credentials
*-credentials.json
gcp-key.json
secrets.yaml
secrets.yml
*.secrets.yaml

# Go vendoring — this project uses modules, not a committed vendor tree
/vendor/
PLAN.md
